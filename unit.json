{
    "listeners": {
        "*:8000": {
            "pass": "routes"
        }
    },
    "routes": [
        {
            "match": {
                "uri": [
                    "*.css",
                    "*.js",
                    "*.png",
                    "*.jpg",
                    "*.jpeg",
                    "*.gif",
                    "*.svg",
                    "*.ico",
                    "*.woff",
                    "*.woff2",
                    "*.ttf",
                    "*.eot"
                ]
            },
            "action": {
                "share": "/var/www/electoral/public$uri"
            }
        },
        {
            "action": {
                "pass": "applications/laravel"
            }
        }
    ],
    "applications": {
        "laravel": {
            "type": "php",
            "root": "/var/www/electoral/public/",
            "script": "index.php",
            "processes": {
                "max": 20,
                "spare": 5,
                "idle_timeout": 30
            }
        }
    }
}